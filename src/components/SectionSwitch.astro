---
// `posts / diary / tags` at the top of the lists: the current one at full contrast, the
// others muted, like the theme switch.
import { sections, type Section } from '../lib/posts'

interface Props {
  current: Section | 'tags'
}
const { current } = Astro.props
const options = [
  { key: 'posts', ...sections.posts },
  { key: 'diary', ...sections.diary },
  { key: 'tags', label: 'tags', path: '/tags/' },
]
---

<nav class="switch" aria-label="Sections">
  {
    options.map((option, i) => (
      <>
        {i > 0 && (
          <span class="divider" aria-hidden="true">
            /
          </span>
        )}
        <a href={option.path} class="option" aria-current={option.key === current ? 'page' : undefined}>
          {option.label}
        </a>
      </>
    ))
  }
</nav>

<style>
  .switch {
    display: flex;
    align-items: baseline;
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .divider {
    padding-inline: 0.35em;
    color: var(--fg-faint);
  }

  .option {
    color: var(--fg-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .option:hover,
  .option[aria-current='page'] {
    color: var(--fg);
  }
</style>
