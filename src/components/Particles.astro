---
// Small squares drifting behind everything, as on the main site but sparser and fainter
// (the --particle token is lighter here), so they don't compete with running text.
---

<canvas class="particles" aria-hidden="true" data-particles></canvas>

<script>
  // One square per this many px² of screen (the main site uses 14,000).
  const AREA_PER_PARTICLE = 22000
  // How far the nearest squares move per px scrolled; deeper ones move proportionally less.
  const PARALLAX = 0.35
  // Drift speed of the nearest squares, in px per second.
  const DRIFT = 10
  // Squares wrap around this far outside the screen, so they never pop in at an edge.
  const MARGIN = 20

  type Particle = { x: number; y: number; vx: number; vy: number; depth: number; size: number }

  function createParticles(count: number, width: number, height: number): Particle[] {
    return Array.from({ length: count }, () => {
      // Skewed toward deep, so most squares are small and faint and a few stand out.
      const depth = 0.15 + 0.85 * Math.random() ** 2
      const angle = Math.random() * Math.PI * 2
      return {
        x: Math.random() * width,
        y: Math.random() * height,
        vx: Math.cos(angle) * DRIFT * depth,
        vy: Math.sin(angle) * DRIFT * depth,
        depth,
        size: 2 + depth * 5,
      }
    })
  }

  const wrap = (value: number, size: number) => ((((value + MARGIN) % size) + size) % size) - MARGIN

  const canvas = document.querySelector<HTMLCanvasElement>('[data-particles]')!
  const ctx = canvas.getContext('2d')!
  const motion = matchMedia('(prefers-reduced-motion: reduce)')
  let width = 0
  let height = 0
  let particles: Particle[] = []
  let color = ''
  let last = performance.now()
  let frame = 0

  const readColor = () => {
    color = getComputedStyle(document.documentElement).getPropertyValue('--particle').trim()
  }

  const resize = () => {
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    width = window.innerWidth
    height = window.innerHeight
    canvas.width = Math.round(width * dpr)
    canvas.height = Math.round(height * dpr)
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
    // Keeps the squares it has (mobile address bars resize the window as you scroll);
    // only adds or drops some to match the new area.
    const count = Math.round((width * height) / AREA_PER_PARTICLE)
    particles =
      count > particles.length
        ? particles.concat(createParticles(count - particles.length, width, height))
        : particles.slice(0, count)
  }

  const draw = () => {
    const scroll = motion.matches ? 0 : window.scrollY
    const fieldW = width + MARGIN * 2
    const fieldH = height + MARGIN * 2
    ctx.clearRect(0, 0, width, height)
    ctx.fillStyle = color
    for (const p of particles) {
      ctx.globalAlpha = 0.3 + 0.7 * p.depth
      ctx.fillRect(wrap(p.x, fieldW), wrap(p.y - scroll * PARALLAX * p.depth, fieldH), p.size, p.size)
    }
  }

  // requestAnimationFrame stops on its own while the tab is hidden.
  const tick = (now: number) => {
    // Capped, so returning to a background tab doesn't jump the squares.
    const dt = Math.min((now - last) / 1000, 0.1)
    last = now
    for (const p of particles) {
      p.x += p.vx * dt
      p.y += p.vy * dt
    }
    draw()
    frame = requestAnimationFrame(tick)
  }

  // Still under reduced motion: drawn once, no drift, no parallax.
  const run = () => {
    cancelAnimationFrame(frame)
    if (motion.matches) draw()
    else {
      last = performance.now()
      frame = requestAnimationFrame(tick)
    }
  }

  readColor()
  resize()
  draw()
  run()

  // Repaint in the new color when the theme changes.
  new MutationObserver(() => {
    readColor()
    draw()
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
  window.addEventListener('resize', () => {
    resize()
    draw()
  })
  motion.addEventListener('change', run)
</script>

<style>
  .particles {
    position: fixed;
    inset: 0;
    z-index: var(--z-particles);
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
