---
// One section's list page: the section switch, a line about the section, then its
// entries.
import { getEntries, sections, type Section } from '../lib/posts'
import EntryRows from './EntryRows.astro'
import SectionSwitch from './SectionSwitch.astro'

interface Props {
  section: Section
}

const { section } = Astro.props
const entries = await getEntries(section)
---

<SectionSwitch current={section} />
<p class="intro">{sections[section].intro}</p>
<EntryRows entries={entries} />

<style>
  .intro {
    max-width: var(--measure);
    margin-top: 1rem;
    color: var(--fg-muted);
  }
</style>
